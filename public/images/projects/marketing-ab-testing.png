<svg xmlns="http://www.w3.org/2000/svg" width="1600" height="1000" viewBox="0 0 1600 1000">
  <rect width="1600" height="1000" fill="#242734"/>
  <!-- Header -->
  <rect x="80" y="60" width="1440" height="80" rx="4" fill="#323647"/>
  <!-- Bar chart -->
  <rect x="80" y="180" width="740" height="460" rx="4" fill="#323647"/>
  <rect x="140" y="500" width="80" height="100" rx="2" fill="#FFAF29" opacity="0.8"/>
  <rect x="260" y="420" width="80" height="180" rx="2" fill="#FFAF29" opacity="0.6"/>
  <rect x="380" y="350" width="80" height="250" rx="2" fill="#FFAF29" opacity="0.9"/>
  <rect x="500" y="450" width="80" height="150" rx="2" fill="#424657"/>
  <rect x="620" y="380" width="80" height="220" rx="2" fill="#424657"/>
  <!-- Pie chart area -->
  <rect x="860" y="180" width="660" height="460" rx="4" fill="#323647"/>
  <circle cx="1190" cy="410" r="160" fill="none" stroke="#FFAF29" stroke-width="40" stroke-dasharray="300 700" opacity="0.9"/>
  <circle cx="1190" cy="410" r="160" fill="none" stroke="#424657" stroke-width="40" stroke-dasharray="400 600" stroke-dashoffset="-300"/>
  <!-- Bottom metrics -->
  <rect x="80" y="680" width="340" height="260" rx="4" fill="#323647"/>
  <rect x="460" y="680" width="340" height="260" rx="4" fill="#323647"/>
  <rect x="840" y="680" width="340" height="260" rx="4" fill="#323647"/>
  <rect x="1220" y="680" width="300" height="260" rx="4" fill="#323647"/>
  <text x="800" y="960" text-anchor="middle" fill="#B4B4B4" font-family="system-ui" font-size="14">Marketing Campaign Performance — placeholder</text>
</svg>
