<svg xmlns="http://www.w3.org/2000/svg" width="1600" height="1000" viewBox="0 0 1600 1000">
  <rect width="1600" height="1000" fill="#242734"/>
  <!-- Header -->
  <rect x="80" y="60" width="1440" height="80" rx="4" fill="#323647"/>
  <!-- Line chart -->
  <rect x="80" y="180" width="1440" height="480" rx="4" fill="#323647"/>
  <polyline points="140,600 280,520 420,540 560,440 700,460 840,380 980,350 1120,300 1260,320 1400,280" fill="none" stroke="#FFAF29" stroke-width="3"/>
  <polyline points="140,580 280,550 420,510 560,500 700,480 840,450 980,430 1120,420 1260,400 1400,380" fill="none" stroke="#424657" stroke-width="2" stroke-dasharray="8,4"/>
  <!-- Grid lines -->
  <line x1="140" y1="250" x2="1460" y2="250" stroke="#424657" stroke-width="0.5"/>
  <line x1="140" y1="350" x2="1460" y2="350" stroke="#424657" stroke-width="0.5"/>
  <line x1="140" y1="450" x2="1460" y2="450" stroke="#424657" stroke-width="0.5"/>
  <line x1="140" y1="550" x2="1460" y2="550" stroke="#424657" stroke-width="0.5"/>
  <!-- Bottom cards -->
  <rect x="80" y="700" width="460" height="240" rx="4" fill="#323647"/>
  <rect x="580" y="700" width="460" height="240" rx="4" fill="#323647"/>
  <rect x="1080" y="700" width="440" height="240" rx="4" fill="#323647"/>
  <text x="800" y="960" text-anchor="middle" fill="#B4B4B4" font-family="system-ui" font-size="14">Consumer Spending Trends — placeholder</text>
</svg>
