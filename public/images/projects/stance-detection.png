<svg xmlns="http://www.w3.org/2000/svg" width="1600" height="1000" viewBox="0 0 1600 1000">
  <rect width="1600" height="1000" fill="#242734"/>
  <!-- Header -->
  <rect x="80" y="60" width="1440" height="80" rx="4" fill="#323647"/>
  <!-- Main content area -->
  <rect x="80" y="180" width="700" height="760" rx="4" fill="#323647"/>
  <!-- Text lines (representing Reddit posts) -->
  <rect x="120" y="220" width="400" height="16" rx="2" fill="#424657"/>
  <rect x="120" y="250" width="620" height="12" rx="2" fill="#424657" opacity="0.6"/>
  <rect x="120" y="270" width="580" height="12" rx="2" fill="#424657" opacity="0.6"/>
  <rect x="120" y="310" width="80" height="24" rx="12" fill="#FFAF29" opacity="0.3"/>
  <rect x="220" y="310" width="80" height="24" rx="12" fill="#424657"/>
  <rect x="120" y="370" width="350" height="16" rx="2" fill="#424657"/>
  <rect x="120" y="400" width="620" height="12" rx="2" fill="#424657" opacity="0.6"/>
  <rect x="120" y="420" width="540" height="12" rx="2" fill="#424657" opacity="0.6"/>
  <rect x="120" y="460" width="80" height="24" rx="12" fill="#424657"/>
  <rect x="220" y="460" width="100" height="24" rx="12" fill="#FFAF29" opacity="0.3"/>
  <!-- Confusion matrix -->
  <rect x="820" y="180" width="700" height="360" rx="4" fill="#323647"/>
  <rect x="880" y="240" width="140" height="120" rx="2" fill="#FFAF29" opacity="0.7"/>
  <rect x="1030" y="240" width="140" height="120" rx="2" fill="#424657" opacity="0.3"/>
  <rect x="1180" y="240" width="140" height="120" rx="2" fill="#424657" opacity="0.2"/>
  <rect x="880" y="370" width="140" height="120" rx="2" fill="#424657" opacity="0.3"/>
  <rect x="1030" y="370" width="140" height="120" rx="2" fill="#FFAF29" opacity="0.6"/>
  <rect x="1180" y="370" width="140" height="120" rx="2" fill="#424657" opacity="0.3"/>
  <!-- Metrics -->
  <rect x="820" y="580" width="700" height="360" rx="4" fill="#323647"/>
  <text x="800" y="960" text-anchor="middle" fill="#B4B4B4" font-family="system-ui" font-size="14">Stance Detection in Mental Health Discourse — placeholder</text>
</svg>
