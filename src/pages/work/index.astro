---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const projects = await getCollection('projects');
const featuredProjects = projects.filter(p => p.data.featured).sort((a, b) =>
  new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);
---

<Base title="Work — Zulqarnain Anjum" description="Portfolio of analytics projects, dashboards, and research work" path="/work">
  <main class="container">
    <section class="work-section">
      <h1 class="page-title">Work</h1>
      <p class="page-intro">A selection of projects that demonstrate how I approach data problems.</p>

      <div class="project-grid">
        {featuredProjects.map((project) => (
          <a href={`/work/${project.id}`} class="project-card">
            <article>
              <div class="card-content">
                <span class="eyebrow">{project.data.tags.slice(0, 2).join(' · ')}</span>
                <h2 class="card-title">{project.data.title}</h2>
                <p class="card-headline">{project.data.headline}</p>
                <div class="card-meta">
                  {project.data.metrics && project.data.metrics.length > 0 && (
                    <ul class="metrics-list">
                      {project.data.metrics.slice(0, 3).map((metric) => (
                        <li>{metric}</li>
                      ))}
                    </ul>
                  )}
                </div>
              </div>
            </article>
          </a>
        ))}
      </div>
    </section>
  </main>
</Base>

<style>
  .work-section {
    padding: var(--space-10) 0 var(--space-10);
  }

  .page-title {
    font-family: var(--font-display);
    font-size: var(--step-display);
    font-weight: 400;
    color: var(--text);
    margin: 0 0 var(--space-3);
  }

  .page-intro {
    font-family: var(--font-body);
    font-size: var(--step-p);
    color: var(--text-body);
    margin: 0 0 var(--space-8);
    max-width: 600px;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
    gap: var(--space-6);
  }

  .project-card {
    display: block;
    text-decoration: none;
    transition: transform var(--transition-fast);
  }

  .project-card:hover {
    transform: translateY(-4px);
  }

  .project-card article {
    background-color: var(--surface-raised);
    border-radius: var(--radius-card);
    padding: var(--space-5);
    height: 100%;
    border: 1px solid var(--hairline);
    transition: border-color var(--transition-fast);
  }

  .project-card:hover article {
    border-color: var(--accent);
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .card-title {
    font-family: var(--font-display);
    font-size: var(--step-h3);
    font-weight: 400;
    color: var(--text);
    margin: 0;
    line-height: 1.2;
  }

  .card-headline {
    font-family: var(--font-body);
    font-size: var(--step-p);
    color: var(--text-body);
    margin: 0;
    line-height: 1.5;
  }

  .metrics-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .metrics-list li {
    font-family: var(--font-body);
    font-size: var(--step-small);
    color: var(--text-muted);
    padding-left: var(--space-3);
    border-left: 2px solid var(--accent);
  }

  @media (max-width: 767px) {
    .project-grid {
      grid-template-columns: 1fr;
    }

    .page-title {
      font-size: var(--step-h1);
    }
  }
</style>