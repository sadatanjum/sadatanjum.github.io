---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Base title={project.data.title + ' — Zulqarnain Anjum'} description={project.data.description} path={`/work/${project.id}`}>
  <article class="project-detail">
    <header class="project-header">
      <div class="container">
        <a href="/#work" class="back-link">← Back to work</a>
        <h1 class="project-title">{project.data.title}</h1>
        <p class="project-description">{project.data.description}</p>

        <div class="project-meta">
          <div class="tags">
            {project.data.tags.map((tag: string) => (
              <span class="tag">{tag}</span>
            ))}
          </div>

          {project.data.metrics && project.data.metrics.length > 0 && (
            <div class="metrics">
              {project.data.metrics.map((metric: string) => (
                <span class="metric">{metric}</span>
              ))}
            </div>
          )}
        </div>

        <div class="project-links">
          {project.data.github && (
            <a href={project.data.github} class="btn-secondary" target="_blank" rel="noopener noreferrer">
              View on GitHub
            </a>
          )}
          {project.data.demo && (
            <a href={project.data.demo} class="btn-primary" target="_blank" rel="noopener noreferrer">
              Live Demo
            </a>
          )}
        </div>
      </div>
    </header>

    <div class="container">
      <div class="project-content">
        <Content />
      </div>
    </div>
  </article>
</Base>

<style>
  .project-detail {
    padding-top: var(--space-8);
    padding-bottom: var(--space-10);
  }

  .project-header {
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--hairline);
  }

  .back-link {
    display: inline-block;
    color: var(--text-muted);
    font-size: var(--step-small);
    margin-bottom: var(--space-4);
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--accent);
  }

  .project-title {
    font-family: var(--font-display);
    font-size: var(--step-display);
    font-weight: 400;
    line-height: 1.1;
    color: var(--text);
    margin: 0 0 var(--space-3);
  }

  .project-description {
    font-family: var(--font-body);
    font-size: var(--step-h3);
    color: var(--text-body);
    line-height: 1.5;
    max-width: 720px;
    margin: 0 0 var(--space-4);
  }

  .project-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tag {
    padding: var(--space-1) var(--space-2);
    background-color: rgba(255, 175, 41, 0.1);
    color: var(--accent);
    font-size: var(--step-tag);
    font-weight: 500;
    border-radius: var(--radius-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .metrics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .metric {
    color: var(--text-muted);
    font-size: var(--step-small);
    padding-left: var(--space-3);
    border-left: 2px solid var(--hairline);
  }

  .project-links {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .project-content {
    max-width: 720px;
    margin: 0 auto;
  }

  .project-content :global(h2) {
    font-family: var(--font-display);
    font-size: var(--step-h2);
    font-weight: 400;
    color: var(--text);
    margin-top: var(--space-8);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--hairline);
  }

  .project-content :global(h2:first-of-type) {
    margin-top: 0;
  }

  .project-content :global(p) {
    font-family: var(--font-body);
    font-size: var(--step-p);
    color: var(--text-body);
    line-height: 1.85;
    margin: 0 0 var(--space-4);
  }

  .project-content :global(ul),
  .project-content :global(ol) {
    font-family: var(--font-body);
    font-size: var(--step-p);
    color: var(--text-body);
    line-height: 1.85;
    margin: 0 0 var(--space-4);
    padding-left: var(--space-5);
  }

  .project-content :global(li) {
    margin-bottom: var(--space-2);
  }

  .project-content :global(code) {
    font-family: monospace;
    font-size: 0.9em;
    padding: 2px 6px;
    background-color: var(--surface-raised);
    color: var(--accent);
    border-radius: var(--radius-sm);
  }

  .project-content :global(pre) {
    background-color: var(--surface-deep);
    padding: var(--space-4);
    border-radius: var(--radius-card);
    overflow-x: auto;
    margin: var(--space-4) 0;
    border: 1px solid var(--hairline);
  }

  .project-content :global(pre code) {
    background: none;
    padding: 0;
    color: var(--text-body);
    font-size: var(--step-p);
  }

  .project-content :global(blockquote) {
    border-left: 4px solid var(--accent);
    padding-left: var(--space-4);
    margin: var(--space-4) 0;
    font-style: italic;
    color: var(--text-muted);
  }

  .project-content :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .project-content :global(a:hover) {
    color: var(--accent-hover);
  }

  .project-content :global(strong) {
    color: var(--text);
    font-weight: 500;
  }

  @media (max-width: 767px) {
    .project-title {
      font-size: var(--step-h1);
    }

    .project-description {
      font-size: var(--step-p);
    }

    .project-links {
      flex-direction: column;
    }

    .project-links a {
      width: 100%;
      text-align: center;
    }
  }
</style>