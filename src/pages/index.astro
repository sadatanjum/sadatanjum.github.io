---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Positioning from '../components/Positioning.astro';
import ServiceCards from '../components/ServiceCards.astro';
import ToolWall from '../components/ToolWall.astro';
import FeaturedWork from '../components/FeaturedWork.astro';
import WorkWithMe from '../components/WorkWithMe.astro';
import Experience from '../components/Experience.astro';
import Contact from '../components/Contact.astro';

const notes = await getCollection('notes');
const hasNotes = notes.length >= 2;
---

<Base title="Zulqarnain Anjum — Data Analyst" description="Data Analyst based in Dhaka, Bangladesh. Specializing in analytics, reporting automation, dashboards, and data visualization." path="/">
  <div class="home">
    <Hero />
    <Positioning />
    <ServiceCards />
    <ToolWall />
    <FeaturedWork />
    <WorkWithMe />
    <Experience />
    <Contact />

    {hasNotes && (
      <section class="notes-section container" id="notes">
        <h2 class="section-heading">Notes</h2>
        <ul class="notes-list">
          {notes.map((note) => (
            <li>
              <span>{note.data.title}</span>
              <span class="note-date">{note.data.publishDate}</span>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Base>

<style>
  .home {
    min-height: 100vh;
  }

  .section-heading {
    font-family: var(--font-display);
    font-size: var(--step-h1);
    color: var(--text);
    margin-top: 0;
    margin-bottom: var(--space-6);
  }

  .notes-section {
    padding: var(--space-8) 0;
    border-top: 1px solid var(--hairline);
    margin-top: var(--space-8);
  }

  .note-date {
    font-family: var(--font-body);
    font-size: var(--step-small);
    color: var(--text-muted);
  }

  .notes-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .notes-list li {
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--surface-raised);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .notes-list li:last-child {
    border-bottom: none;
  }
</style>
