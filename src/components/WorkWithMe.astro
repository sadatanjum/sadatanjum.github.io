<section class="work-with-me" aria-label="Work with me">
  <div class="container">
    <div class="band-grid">
      <!-- For Employers -->
      <article class="band-card">
        <h3 class="band-title">For employers</h3>
        <ul class="band-list">
          <li>Looking for: Data Analyst · Business Analyst · MIS / Reporting Analyst roles</li>
          <li>Based in Dhaka, Bangladesh · open to hybrid and remote</li>
          <li>Currently: Data Analyst Intern at CarryBee Express, MSc in progress</li>
        </ul>
        <div class="band-ctas">
          <a href="/resume.pdf" class="btn-secondary" target="_blank" rel="noopener noreferrer" download="Zulqarnain-Anjum-Data-Analyst.pdf">Download résumé</a>
          <a href="https://linkedin.com/in/sadatanjum" class="btn-text" target="_blank" rel="noopener noreferrer">Connect on LinkedIn →</a>
        </div>
      </article>

      <!-- For Clients -->
      <article class="band-card">
        <h3 class="band-title">For clients</h3>
        <ul class="band-list">
          <li>Typical projects: reporting automation, dashboard build, one-off analysis with a written recommendation</li>
          <li>Engagements usually run 1–4 weeks; fixed scope, fixed fee</li>
          <li>Rates on request — send the problem, get a quote within two working days</li>
        </ul>
        <div class="band-ctas">
          <a href="/#contact" class="btn-primary" onclick="document.getElementById('subject').value = 'freelance'">Start a project</a>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .work-with-me {
    padding: var(--space-9) 0;
    background-color: var(--surface-deep);
  }

  .band-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }

  .band-card {
    background-color: var(--surface);
    border-radius: var(--radius-card);
    padding: var(--space-6);
    border: 1px solid var(--hairline);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .band-title {
    font-family: var(--font-display);
    font-size: var(--step-h3);
    font-weight: 400;
    color: var(--text);
    margin: 0;
  }

  .band-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .band-list li {
    font-family: var(--font-body);
    font-size: var(--step-p);
    color: var(--text-body);
    line-height: 1.6;
    padding-left: var(--space-3);
    border-left: 2px solid var(--hairline);
  }

  .band-ctas {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: auto;
  }

  .btn-text {
    font-family: var(--font-body);
    font-size: var(--step-small);
    color: var(--accent);
    text-decoration: none;
    text-align: center;
    padding: var(--space-2);
    transition: color var(--transition-fast);
  }

  .btn-text:hover {
    color: var(--accent-hover);
  }

  @media (max-width: 767px) {
    .band-grid {
      grid-template-columns: 1fr;
    }

    .band-card {
      padding: var(--space-5);
    }
  }
</style>