---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-content">
      <div class="logo-mark" aria-hidden="true">
        <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="40" height="40" rx="4" fill="var(--accent)"/>
          <path d="M12 28V12L28 28V12" stroke="var(--on-accent)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>

      <p class="footer-joke">
        <span class="joke-accent">Thanks for scrolling,</span>
        <span class="joke-muted">that's all folks.</span>
      </p>

      <div class="social-links">
        <a href="https://github.com/sadatanjum" aria-label="GitHub" target="_blank" rel="noopener noreferrer">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
          </svg>
        </a>
        <a href="https://linkedin.com/in/sadatanjum" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
            <rect x="2" y="9" width="4" height="12"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
        </a>
        <a href="mailto:anjumsadat09082@gmail.com" aria-label="Email">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
        </a>
      </div>

      <p class="copyright">
        © {currentYear} Md. Zulqarnain Anjum &middot; Dhaka, Bangladesh
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--surface-deep);
    padding: var(--space-9) 0;
    text-align: center;
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
  }

  .logo-mark rect {
    fill: var(--accent);
  }

  .footer-joke {
    font-family: var(--font-display);
    font-size: var(--step-h3);
    margin: 0;
  }

  .joke-accent {
    color: var(--accent);
    font-weight: 500;
  }

  .joke-muted {
    color: var(--text-muted);
  }

  .social-links {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-2);
  }

  .social-links a {
    color: var(--text-muted);
    transition: color var(--transition-fast);
  }

  .social-links a:hover {
    color: var(--accent);
  }

  .copyright {
    color: var(--text-muted);
    font-size: var(--step-small);
    margin-top: var(--space-4);
  }
</style>
