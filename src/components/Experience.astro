---
---

<section class="experience" id="about" aria-label="Experience">
  <div class="container">
    <div class="experience-header">
      <span class="eyebrow">— Experience</span>
      <h2 class="section-heading">Where I've worked and what I've learned.</h2>
    </div>

    <div class="timeline">
      <!-- Current Role -->
      <article class="timeline-item current">
        <div class="timeline-marker" aria-hidden="true"></div>
        <div class="timeline-content">
          <span class="timeline-date">May 2026 – Present</span>
          <h3 class="timeline-title">Data Analyst Intern</h3>
          <span class="timeline-company">CarryBee Express Ltd. (a concern of US-Bangla)</span>
          <ul class="timeline-details">
            <li>Daily operational reporting from SQL extracts, feeding management decisions</li>
            <li>Built and maintained KPI dashboards and automated workflows across Google Workspace</li>
          </ul>
        </div>
      </article>

      <!-- Previous Roles -->
      <article class="timeline-item">
        <div class="timeline-marker" aria-hidden="true"></div>
        <div class="timeline-content">
          <span class="timeline-date">Nov 2025 – Feb 2026</span>
          <h3 class="timeline-title">AI Developer Intern</h3>
          <span class="timeline-company">Nexvix</span>
          <ul class="timeline-details">
            <li>Documented technical requirements and translated business demands into implementable specs</li>
          </ul>
        </div>
      </article>

      <article class="timeline-item">
        <div class="timeline-marker" aria-hidden="true"></div>
        <div class="timeline-content">
          <span class="timeline-date">Feb 2022 – Oct 2025</span>
          <h3 class="timeline-title">Teacher & Academic Material Developer</h3>
          <span class="timeline-company">Udvash Academic & Admission Care</span>
          <ul class="timeline-details">
            <li>Taught and presented to large groups; managed guardian and management communication</li>
          </ul>
        </div>
      </article>

      <article class="timeline-item">
        <div class="timeline-marker" aria-hidden="true"></div>
        <div class="timeline-content">
          <span class="timeline-date">2024 – 2025</span>
          <h3 class="timeline-title">Project-based Contractor</h3>
          <span class="timeline-company">Turing & micro1</span>
          <ul class="timeline-details">
            <li>Short-term technical assignments delivered to external deadlines</li>
          </ul>
        </div>
      </article>
    </div>

    <div class="education">
      <h3 class="education-heading">Education</h3>
      <div class="education-grid">
        <article class="education-item">
          <span class="education-date">2026 – Present</span>
          <h4 class="education-title">MSc Data Science & Applied Statistics</h4>
          <span class="education-school">Jahangirnagar University</span>
        </article>
        <article class="education-item">
          <span class="education-date">2021 – 2025</span>
          <h4 class="education-title">BSc Computer Science & Engineering</h4>
          <span class="education-school">BRAC University</span>
        </article>
      </div>
    </div>
  </div>
</section>

<style>
  .experience {
    padding: var(--space-9) 0;
  }

  .experience-header {
    margin-bottom: var(--space-7);
  }

  .section-heading {
    font-family: var(--font-display);
    font-size: var(--step-h1);
    font-weight: 400;
    color: var(--text);
    margin: var(--space-3) 0 0;
  }

  .timeline {
    position: relative;
    padding-left: var(--space-6);
    border-left: 1px solid var(--hairline);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .timeline-item {
    position: relative;
  }

  .timeline-marker {
    position: absolute;
    left: calc(-1 * var(--space-6) - 5px);
    top: 8px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: var(--surface-raised);
    border: 2px solid var(--text-muted);
  }

  .timeline-item.current .timeline-marker {
    background-color: var(--accent);
    border-color: var(--accent);
  }

  .timeline-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .timeline-date {
    font-family: var(--font-body);
    font-size: var(--step-small);
    color: var(--text-muted);
  }

  .timeline-title {
    font-family: var(--font-display);
    font-size: var(--step-h3);
    font-weight: 400;
    color: var(--text);
    margin: 0;
  }

  .timeline-company {
    font-family: var(--font-body);
    font-size: var(--step-p);
    color: var(--text-body);
  }

  .timeline-details {
    list-style: none;
    padding: 0;
    margin: var(--space-2) 0 0;
  }

  .timeline-details li {
    font-family: var(--font-body);
    font-size: var(--step-small);
    color: var(--text-muted);
    padding-left: var(--space-3);
    border-left: 2px solid var(--hairline);
    margin-bottom: var(--space-1);
  }

  .education {
    padding-top: var(--space-6);
    border-top: 1px solid var(--hairline);
  }

  .education-heading {
    font-family: var(--font-display);
    font-size: var(--step-h3);
    font-weight: 400;
    color: var(--text);
    margin: 0 0 var(--space-4);
  }

  .education-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  .education-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .education-date {
    font-family: var(--font-body);
    font-size: var(--step-small);
    color: var(--text-muted);
  }

  .education-title {
    font-family: var(--font-body);
    font-size: var(--step-p);
    font-weight: 500;
    color: var(--text);
    margin: 0;
  }

  .education-school {
    font-family: var(--font-body);
    font-size: var(--step-small);
    color: var(--text-body);
  }

  @media (max-width: 767px) {
    .section-heading {
      font-size: var(--step-h2);
    }

    .education-grid {
      grid-template-columns: 1fr;
    }
  }
</style>