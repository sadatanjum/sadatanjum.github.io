---
<section class="tool-wall" aria-label="Tools">
  <div class="container">
    <div class="tools-grid">
      <div class="tool-item"><span>Python</span></div>
      <div class="tool-item"><span>SQL</span></div>
      <div class="tool-item"><span>PostgreSQL</span></div>
      <div class="tool-item"><span>Power BI</span></div>
      <div class="tool-item"><span>Tableau</span></div>
      <div class="tool-item"><span>Excel</span></div>
      <div class="tool-item"><span>Apps Script</span></div>
      <div class="tool-item"><span>n8n</span></div>
      <div class="tool-item"><span>Google Workspace</span></div>
      <div class="tool-item"><span>Git</span></div>
      <div class="tool-item"><span>Looker Studio</span></div>
    </div>
  </div>
</section>

<style>
.tool-wall { padding: var(--space-9) 0; }
.tools-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-6); align-items: center; }
.tool-item { opacity: 0.55; font-family: var(--font-body); font-size: var(--step-small); color: var(--text-muted); transition: opacity var(--transition-fast); }
.tool-item:hover { opacity: 0.85; }
</style>
